# Badge states nothing can derive (.github#316): one line per shield
# that waits on a human step. Set each line LAST — audit:badges re-asks
# the issuer, and an id set before the issuer agrees is a red Monday.
# bestpractices: 'pending' until the form binds, then the BP_ID.
# reuse: 'pending' until FSFE registration confirms, then 'registered'.
bestpractices pending
reuse registered
# static: a claim of this repository's own (.github#1161) —
# 'static <path> <label>=<message>', where <path> is the tracked file
# that enforces it. The release refuses an image over 25 MB unpacked.
static scripts/check_image_size.sh image=<25 MB
